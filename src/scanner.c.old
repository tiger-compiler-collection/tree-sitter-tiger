#include "tree_sitter/parser.h"
#include "tree_sitter/alloc.h"
#include "tree_sitter/array.h"
#include <stdbool.h>

enum TokenType { COMMENT, STRING_LITERAL };

// some simple string escape parser helper functions.
bool is_decimal(char c) { return '0' <= c && c <= '9'; }

bool is_formatting_blank(char c) {
  return c == ' ' || c == '\t' || c == '\n' || c == '\f';
}

bool is_single_escape(char c) {
  return c == 'n' || c == 't' || c == 'c' || c == '"' || c == '\\';
}

bool is_control_char(char c) {
  // ascii code 64 to 95 and 63, representing ascii code 0-32 and 127
  return '?' <= c && c <= '_';
}

void * tree_sitter_tiger_external_scanner_create() {
  return NULL;
}

void tree_sitter_my_language_external_scanner_destroy(void *payload) {
}

unsigned tree_sitter_my_language_external_scanner_serialize(
  void *payload,
  char *buffer
) {
  return 0;
}

void tree_sitter_my_language_external_scanner_deserialize(
  void *payload,
  const char *buffer,
  unsigned length
) {
}

bool tree_sitter_my_language_external_scanner_scan(
  void *payload,
  TSLexer *lexer,
  const bool *valid_symbols
) {
  int comment_depth = 0;

  if (lexer->lookahead == '"' && valid_symbols[STRING_LITERAL]) {
    goto string_literal;
  } else if (lexer->lookahead == '/' && valid_symbols[COMMENT]) {
    lexer->advance(lexer, false);
    if (lexer->lookahead == '*') {
      comment_depth += 1;
      goto comment;
    } else {
      return false;
    }
  } else {
    return false;
  }

// scan the string literal
string_literal:
  bool in_escape = false;

  // set a enum type for multiple character escape: either previous is for a
  // control character, or a ASCII code or any length of blank characters.
  enum EscapeType { NONE, SINGLE, CONTROL, DECIMAL, BLANK };

  // scan 3 chars after the escape '\'
  // acceptable: [ ][ ][ ], [0-9][0-9][0-9]
  enum EscapeType escape1 = NONE;
  enum EscapeType escape2 = NONE;
  enum EscapeType escape3 = NONE;

  lexer->advance(lexer, false);
  while (lexer->lookahead != '"' && !lexer->eof(lexer)) {
    if (in_escape) {
    } else if (lexer->lookahead == '\\') {
      in_escape = true;
    } 
    lexer->advance(lexer, false);
  }

  if (lexer->lookahead == '"') {
    lexer->advance(lexer, false);
    lexer->result_symbol = STRING_LITERAL;
    return true;
  }
  return false;

// scan the comment
comment:
  lexer->advance(lexer, false);
  // design a two char sliding window to detect nested comment depth
  enum CommentChar { NORMAL, SLASH, STAR };
  enum CommentChar current = NORMAL;
  enum CommentChar prev = NORMAL;

  while (comment_depth > 0 && !lexer->eof(lexer)) {
    if (lexer->lookahead == '/') {
      current = SLASH;
    } else if (lexer->lookahead == '*') {
      current = STAR;
    } else {
      current = NORMAL;
    }

    // now handle "/*" and "*/"
    if (prev == SLASH && current == STAR) {
      comment_depth += 1;
      // after this matches we need to set the current to NORMAL to avoid
      // matching another '/' like "/*/"
      current = NORMAL;
    } else if (prev == STAR && current == SLASH) {
      comment_depth -= 1;
      current = NORMAL;
    }

    lexer->advance(lexer, false);
    prev = current;
  }

  // handle unclosed comment
  if (lexer->eof(lexer) && comment_depth > 0) {
    return false;
  } else {
    lexer->result_symbol = COMMENT;
    return true;
  }
}
