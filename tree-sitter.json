{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "tiger",
      "camelcase": "Tiger",
      "title": "Tiger",
      "scope": "source.tiger",
      "file-types": [
        ".tig"
      ],
      "injection-regex": "^tiger$",
      "class-name": "TreeSitterTiger"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "GNU",
    "description": "Tiger grammar for tree-sitter",
    "authors": [
      {
        "name": "Pusen Yi",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tiger-compiler-collection/tree-sitter-tiger",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}